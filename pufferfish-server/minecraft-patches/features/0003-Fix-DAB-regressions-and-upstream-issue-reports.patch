From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexteens24 <email_cua_ban@gmail.com>
Date: Fri, 19 Jun 2026 07:41:47 +0700
Subject: [PATCH] Fix DAB regressions and upstream issue reports

Restore behaviorTick throttling for all brain-using mobs, fix stale
activatedPriority when entities are not updated by ActivationRange,
keep goal selectors running when throttled, prevent villager drowning,
remove unused cachedBlockPos, and default-blacklist warden from DAB.

Co-authored-by: Cursor <cursoragent@cursor.com>

diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index 81d4471240d54b79fb4f19885eaf01eee571c8eb..c0c7429ad706934105e70bb1eab1077f6224c4d8 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -169,6 +169,7 @@ public final class ActivationRange {
 
                 // Pufferfish start
                 if (gg.pufferfish.pufferfish.PufferfishConfig.dearEnabled && entity.getType().dabEnabled) {
+                    entity.dabPriorityUpdatedThisTick = true;
                     if (!entity.activatedPriorityReset) {
                         entity.activatedPriorityReset = true;
                         entity.activatedPriority = gg.pufferfish.pufferfish.PufferfishConfig.maximumActivationPrio;
@@ -180,6 +181,11 @@ public final class ActivationRange {
                     entity.activatedPriority = squaredDistance > gg.pufferfish.pufferfish.PufferfishConfig.startDistanceSquared ?
                             Math.max(1, Math.min(squaredDistance >> gg.pufferfish.pufferfish.PufferfishConfig.activationDistanceMod, entity.activatedPriority)) :
                             1;
+                    if (entity instanceof net.minecraft.world.entity.LivingEntity living
+                            && living.isInWater()
+                            && !living.canBreatheUnderwater()) {
+                        entity.activatedPriority = 1;
+                    }
                 } else {
                     entity.activatedPriority = 1;
                 }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index b7c6e5ca81a85aab69cf0b590d64a8b1553e3527..336af2b74e0559f90ea6507813dd63f05b638426 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -874,7 +874,13 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             this.entityTickList
                 .forEach(
                     entity -> {
-                        entity.activatedPriorityReset = false; // Pufferfish - DAB
+                        // Pufferfish start - DAB
+                        if (gg.pufferfish.pufferfish.PufferfishConfig.dearEnabled && entity.getType().dabEnabled && !entity.dabPriorityUpdatedThisTick) {
+                            entity.activatedPriority = 1;
+                        }
+                        entity.dabPriorityUpdatedThisTick = false;
+                        entity.activatedPriorityReset = false;
+                        // Pufferfish end
                         if (!entity.isRemoved()) {
                             if (!tickRateManager.isEntityFrozen(entity)) {
                                 profiler.push("checkDespawn");
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 3cb4e24dcb25dc6e69519f91a04cc7f8a6b8ac80..1a6bfdd0cb5b3cf3bb8edbe59e370efb38b23858 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -367,9 +367,9 @@ public abstract class Entity
     public boolean lastDamageCancelled; // SPIGOT-5339, SPIGOT-6252, SPIGOT-6777: Keep track if the event was canceled
     public boolean activatedPriorityReset = false; // Pufferfish - DAB
     public int activatedPriority = gg.pufferfish.pufferfish.PufferfishConfig.maximumActivationPrio; // Pufferfish - DAB (golf score)
+    public boolean dabPriorityUpdatedThisTick = false; // Pufferfish - DAB
     public boolean persistentInvisibility = false;
     public @Nullable BlockPos lastLavaContact;
-    public final BlockPos.MutableBlockPos cachedBlockPos = new BlockPos.MutableBlockPos(); // Pufferfish - reduce entity allocations
     // Marks an entity, that it was removed by a plugin via Entity#remove
     // Main use case currently is for SPIGOT-7487, preventing dropping of leash when leash is removed
     public boolean pluginRemoved = false;
diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index 853c2b5466fb491bfda6c893ee58dfac41ce81c2..c498191be7184415568df3a6137dcad64c8efc8b 100644
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -819,21 +819,21 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
         int idBasedTickCount = this.tickCount + this.getId();
         if (idBasedTickCount % 2 != 0 && this.tickCount > 1) {
             profiler.push("targetSelector");
-            if (this.targetSelector.inactiveTick(this.activatedPriority, false)) // Pufferfish
-            this.targetSelector.tickRunningGoals(false);
+            this.targetSelector.tickRunningGoals(false); // Pufferfish - always tick running goals on off ticks
             profiler.pop();
             profiler.push("goalSelector");
-            if (this.goalSelector.inactiveTick(this.activatedPriority, false)) // Pufferfish
-            this.goalSelector.tickRunningGoals(false);
+            this.goalSelector.tickRunningGoals(false); // Pufferfish - always tick running goals on off ticks
             profiler.pop();
         } else {
             profiler.push("targetSelector");
             if (this.targetSelector.inactiveTick(this.activatedPriority, false)) // Pufferfish
             this.targetSelector.tick();
+            else this.targetSelector.tickRunningGoals(false); // Pufferfish - keep running goals when throttled
             profiler.pop();
             profiler.push("goalSelector");
             if (this.goalSelector.inactiveTick(this.activatedPriority, false)) // Pufferfish
             this.goalSelector.tick();
+            else this.goalSelector.tickRunningGoals(false); // Pufferfish - keep running goals when throttled
             profiler.pop();
         }
 
diff --git a/net/minecraft/world/entity/ai/goal/GoalSelector.java b/net/minecraft/world/entity/ai/goal/GoalSelector.java
